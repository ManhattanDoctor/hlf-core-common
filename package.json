{
    "name": "@hlf-core/common",
    "version": "3.2.7",
    "description": "TypeScript library with core classes shared across hlf-core packages: Hyperledger Fabric state key building, user identifiers, crypto keys, transport commands and domain errors",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.57"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/hlf-core-common.git"
    },
    "keywords": [
        "hyperledger",
        "hyperledger-fabric",
        "fabric",
        "chaincode",
        "blockchain",
        "distributed-ledger",
        "state-key",
        "composite-key",
        "typescript"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/hlf-core-common/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/hlf-core-common#readme"
}
